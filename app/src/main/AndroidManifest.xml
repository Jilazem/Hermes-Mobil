<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Uygulama durdurma: erişilebilirlik API'si başka bir uygulamayı zorla
         kapatamıyor (force-stop kabuk yetkisi ister). Bu izin yalnız arka
         plan sürecini öldürmeye yarıyor; sonuç mesajı da bunu açıkça yazıyor. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Okuma tarafı. Hiçbiri zorunlu değil: izin verilmezse ilgili araç
         "izin yok, şuradan verebilirsin" diyor, uygulama çalışmaya devam
         ediyor. Yazma izni istemiyoruz — asistan rehbere/takvime yazmıyor,
         yalnız okuyor; etkinlik eklemek zaten takvim uygulamasını açarak
         kullanıcının onayıyla oluyor. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Android 11+ paket görünürlüğü: STT/TTS motorları ayrı uygulamalardır,
         sorgulanamazsa SpeechRecognizer.isRecognitionAvailable() false döner. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Telefon araçları: "şunu aç" diyebilmek için kurulu uygulamaları
             görebilmemiz gerekiyor. QUERY_ALL_PACKAGES yerine yalnız
             başlatılabilir uygulamaları soruyoruz — yeterli ve daha dar. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <package android:name="net.dinglisch.android.taskerm" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".HermesApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HermesMobile">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.HermesMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Dijital asistan: Ayarlar → Varsayılan uygulamalar → Dijital
                 asistan listesinde Hermes görünür; asistan hareketi doğrudan
                 canlı sesi açar. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- PAYLAŞIM FİLTRESİ BURADA DEĞİL: paylaşım girdisi yalnız
                 şeffaf ShareProxyActivity üzerinden akar (aşağıda).
                 MainActivity'de kendi SEND/SEND_MULTIPLE filtresi olursa
                 "Paylaş" menüsünde Hermes İKİ KEZ görünür — vekil ekstrapları
                 akışı zaten MainActivity'e taşıyor, buradaki filtre gereksiz. -->
        </activity>
        <!-- Sürüş kipi: ekran kapalıyken mikrofonun çalışmaya devam etmesi
             Android 14+'ta bu servisi zorunlu kılıyor. -->
        <service
            android:name=".data.DrivingModeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Bildirimden yanıt: soketi açık tutup ajanın cevabını beklemek
             gerekiyor, alıcının 10 sn'lik penceresi yetmiyor. -->
        <service
            android:name=".data.ReplyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Shizuku sağlayıcısı. `permission` alanı normal uygulamaların
             erişimini engelliyor — Shizuku'nun kendi dokümanı bunu şart koşuyor. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Ajan→telefon kanalı: telefon sunucuya giden kalıcı bir WebSocket
             açıyor, böylece cron/Telegram/CLI'dan çalışan ajan da telefon
             araçlarını çağırabiliyor. Varsayılan kapalı; açıkken kalıcı
             bildirim gösteriliyor — gizli bir uzaktan erişim kanalı olmamalı. -->
        <service
            android:name=".data.PhoneBridgeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Bildirim okuma: "bugün ne kaçırdım?".
             Normal izinle olmuyor, kullanıcı Ayarlar → Bildirim erişimi'nden
             elle vermek zorunda. Servis hiçbir şey saklamıyor; sorulduğu anda
             duran bildirimleri okuyor. -->
        <service
            android:name=".data.HermesNotificationListener"
            android:exported="false"
            android:label="Hermes"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Ajan yanıt üretirken süreci ayakta tutar; yanıt gelince durur. -->
        <service
            android:name=".data.AwaitReplyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- "Tam kontrol" — ekran okuma, dokunma, yazma, jest, ekran görüntüsü.
             İzni kullanıcı Ayarlar → Erişilebilirlik'ten veriyor; uygulama bu
             izni programatik olarak isteyemez (Android'in bilinçli kısıtı).
             `exported="false"`: servisi yalnız sistem bağlıyor, üçüncü taraf
             uygulamalar bağlayamıyor — BIND_ACCESSIBILITY_SERVICE zaten bunu
             şart koşuyor (bildirim dinleyicisiyle aynı desen). -->
        <service
            android:name=".data.HermesAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_full_control" />
        </service>


        <!-- Hızlı Ayarlar döşemesi: perdeyi indir, dokun, konuş. -->
        <service
            android:name=".data.VoiceTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Hermes'e konuş"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Android Auto. Yan yüklendiği için Auto'nun geliştirici ayarlarında
             "Bilinmeyen kaynaklar" açık olmalı; Play Store dağıtımı genel amaçlı
             asistanları kabul etmiyor. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <service
            android:name=".car.HermesCarService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!-- Share vekili: WhatsApp/Telegram/galeri/tarayıcı "Paylaş"
             menüsünden gelen ACTION_SEND niyetini şeffaf proxy'de yakalar; hedef (oturum seçim
             sayfası) belirlenir, MainActivity'e iletilir. Tek filtre, mimeType
             her zaman */* (çiplak * geçersiz; ayrı text/plain filtresi de
             çakışma/çift girdi riski taşır). -->
        <activity
            android:name=".ShareProxyActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

    </application>

</manifest>
