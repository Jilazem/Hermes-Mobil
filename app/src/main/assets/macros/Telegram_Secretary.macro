"supportsOutput":true},"disableLogging":false,"m_SIGUID":-6576009062557339053,"m_classType":"SetVariableAction","m_comment":"Prepare final AI message","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"dictionaryVarName":"requestBodyDict","stringVarName":"requestBody","disableLogging":false,"m_SIGUID":-8166731984663729236,"m_classType":"JsonOutputAction","m_comment":"Prepare final AI message body","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"requestConfig":{"allFilesAccessPath":"","allowAnyCertificate":true,"basicAuthEnabled":false,"basicAuthPassword":"","basicAuthUsername":"","blockNextAction":true,"clientCertEnabled":false,"clientCertKeyStoreDisplayName":"","clientCertKeyStoreUri":"","clientCertPassword":"","contentBodyDynamicFileName":"","contentBodyFileDisplayName":"","contentBodyFileUri":"","contentBodyFolderDisplayName":"","contentBodyFolderUri":"","contentBodySource":0,"contentBodyText":"{lv\u003drequestBody}","contentType":"application/json","followRedirects":true,"headerParams":[{"paramName":"Content-Type","paramValue":"application/json"}],"localFileUri":"","maxTotalDurationSeconds":3600,"prettifyJson":true,"proxyEnabled":false,"proxyHost":"","proxyPort":8080,"proxyType":0,"queryParams":[],"requestTimeOutSeconds":30,"requestType":1,"responseVariableName":"responseBody","returnCodeVariableName":"responseCode","saveResponseAllFilesAccessPath":"","saveResponseFileName":"","saveResponseFolderPathDisplayName":"","saveResponseFolderPathUri":"","saveResponseType":1,"saveResponseUseAllFilesAccess":false,"saveReturnCodeToVariable":true,"saveReturnHeadersToVariable":false,"urlToOpen":"https://api.telegram.org/bot{lv\u003dtgApiToken}/sendMessage?parse_mode\u003dHTML","useAllFilesAccess":false,"useLocalFileUri":false,"useStaticContentBodyFile":true},"disableLogging":false,"m_SIGUID":-5406140255605971170,"m_classType":"HttpRequestAction","m_comment":"Telegram sendMessage","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-6347803190870697709,"m_classType":"EndIfAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"disableLogging":false,"m_SIGUID":-5208565204826753346,"m_classType":"EndIfAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_category":"Связь","m_completed":true,"m_constraintList":[],"m_description":"🤖 Telegram AI Secretary for MacroDroid\n\nAI assistant for Telegram that automatically replies to incoming messages. You have time to answer manually before AI takes over.\n\n⭐️ Features:\n\n- 🤖 AI replies to incoming Telegram Business messages\n- ⏱️ Configurable delay before AI generation\n- 🛑 Cancels AI reply if you answer manually\n- 🔐 Owner authorization\n- 🌐 Automatic language detection\n- ⌨️ Telegram typing indicator\n- 🔗 Automatic Webhook registration\n- ⚙️ Configurable AI provider and model\n\n---\n\n⚙️ First setup:\n\n1. 🤖 Create a bot with @BotFather using \"/newbot\"\n2. 🔑 Put the Telegram Bot API token into \"tgApiToken\"\n3. 🧠 Put your AI API keys into \"aiApiKeys\" in the AI LLM Query action\n4. 👤 Send \"/start\" to your bot from your Telegram account to register your Owner ID\n5. ⏱️ Set \"aiDelaySeconds\" - recommended: 15-30 seconds\n6. 📝 Customize the AI instructions in the prompts variable\n7. ▶️ Enable the macro or run Test Macro to register the Webhook\n\nℹ️ Important: The macro processes only incoming messages and does not store conversation history. AI receives only the latest incoming message.\n\n🏁 Done! Your Telegram AI Secretar is ready!","m_descriptionOpen":false,"m_enabled":false,"m_excludeLog":false,"m_headingColor":0,"m_isOrCondition":false,"m_name":"Telegram Secretary 🤖","m_triggerList":[{"identifier":"{lv\u003dwebhookId}","ipAddressWhiteList":[],"saveBodyVariableName":"responseBody","variableWhiteList":[],"variableWhiteListEnabled":false,"disableLogging":false,"m_SIGUID":-9014767187526169700,"m_classType":"WebHookTri