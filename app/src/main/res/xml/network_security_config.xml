<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE/MAIN — TLS zorunlu, yalnız sistem güven kökleri.
  Cleartext platform düzeyinde kapalıdır. Özel ağ (RFC1918 / localhost /
  *.local) için düz HTTP yalnız debug kaynak kümesindeki aynı adlı dosyada
  açılır ve orada bile uygulama kapısı ServerProfile.forceTlsOutsideLan()
  özel ağ dışındaki adresleri https://'e yükseltir.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
