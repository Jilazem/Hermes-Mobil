<?xml version="1.0" encoding="utf-8"?>
<!-- Release requires TLS with system trust. Personal LAN HTTP is debug-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
