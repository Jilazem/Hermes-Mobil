<?xml version="1.0" encoding="utf-8"?>
<!--
  Hermes sunucuları ev ağında / Tailscale üzerinde düz HTTP konuşur
  (the server: http://192.168.1.10:9150). Kullanıcı istediği host'u profil olarak
  ekleyebildiği için host listesi derleme zamanında bilinemez; bu yüzden
  cleartext genel olarak açık. Profil URL'i https ise TLS zaten kullanılır.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
