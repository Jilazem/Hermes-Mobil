<?xml version="1.0" encoding="utf-8"?>
<!--
  Yalnız DEBUG build'e merge olur (src/debug source set): mesaj render
  tasarımı için görsel kanıt ekranı. Launcher'da YOK — yalnız adb'den
  explicit component ile açılır. Üretim (release) manifest'ine sızmaz.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".ui.MobileReviewActivity" android:exported="${hermesProofExported}" android:theme="@style/Theme.HermesMobile" />
        <activity android:name=".ui.MolaPanelProofActivity" android:exported="${hermesProofExported}" android:theme="@style/Theme.HermesMobile" />
        <activity android:name=".ui.VoiceSpecialistProofActivity" android:exported="${hermesProofExported}" />
        <activity android:name=".ui.CarMessagingProofActivity" android:exported="${hermesProofExported}" />
        <activity android:name=".ui.VoiceReadinessActivity" android:exported="${hermesProofExported}" android:label="Ses Bağlantısı Kontrolü" android:theme="@style/Theme.HermesMobile" />
        <activity android:name=".ui.CarFocusProofActivity" android:exported="${hermesProofExported}" android:label="Araç Ses Odağı Kontrolü" android:theme="@style/Theme.HermesMobile" />
        <activity android:name=".ui.EmaOfflineSelfTestActivity" android:exported="${hermesProofExported}" android:label="EMA Çevrimdışı Öz-Testi" android:theme="@style/Theme.HermesMobile" />
        <activity android:name=".ui.EmaSelfTestActivity" android:exported="${hermesProofExported}"
            android:label="EMA Öz-Testi" android:theme="@style/Theme.HermesMobile" />
        <activity android:name=".ui.FullControlSelfTestActivity" android:exported="${hermesProofExported}"
            android:label="Kontrol Öz-Testi" android:theme="@style/Theme.HermesMobile" />
        <activity android:name=".ui.UnifiedSessionSelfTestActivity" android:exported="${hermesProofExported}"
            android:label="Oturum Öz-Testi" android:theme="@style/Theme.HermesMobile" />
        <activity
            android:name=".ui.MarkdownRenderDebugActivity"
            android:exported="${hermesProofExported}"
            android:label="Render Kanıtı"
            android:theme="@style/Theme.HermesMobile" />

        <!-- Tur-6: "tam kontrol" zincirini kurmak için ayar tohumlayıcı.
             Yalnız debug; token dosyadan okunur, komut satırına yazılmaz. -->
        <activity
            android:name=".ui.Tur6SeedActivity"
            android:exported="${hermesProofExported}"
            android:label="Tur6 Tohum"
            android:noHistory="true"
            android:theme="@style/Theme.HermesMobile" />

        <!-- Tur-11: sesli mesaj öz-testi. Asset'teki kaydı gerçek istemci
             koduyla uca yükler (/transcribe → metin), sentezleyip indirir
             (/synthesize → ogg) ve MediaPlayer ile çalar. Token intent
             extra'sıyla geçirilir; kaynakta/kalıcı depoda durmaz. -->
        <activity
            android:name=".ui.VoiceSelfTestActivity"
            android:exported="${hermesProofExported}"
            android:label="Sesli Mesaj Öz-Testi"
            android:noHistory="true"
            android:theme="@style/Theme.HermesMobile" />

        <!-- Tur-21: yerel kadın sesi (Piper/sherpa-onnx) + yerel LLM
             sağlık/chat öz-testi. Kanıt WAV'ları shared-depo dışı
             filesDir.parentFile/local-tts-kanit'e yazılır (run-as ile çekilir). -->
        <activity
            android:name=".ui.JarvisVisualTestActivity"
            android:exported="${hermesProofExported}"
            android:label="Jarvis Görsel Testi"
            android:theme="@style/Theme.HermesMobile" />

        <activity
            android:name=".ui.LocalTtsSelfTestActivity"
            android:exported="${hermesProofExported}"
            android:label="Yerel Ses Öz-Testi"
            android:noHistory="true"
            android:theme="@style/Theme.HermesMobile" />

        <!-- Tur-13: telefon asistanı öz-testi. Asistan modu kararlarını (saf
             katman) + kayıt durum makinesini + gerçek istemciyle transcribe →
             oto-okuma → sentez → çalma zincirini koşturur. Token intent
             extra'sıyla geçirilir; kaynakta/kalıcı depoda durmaz. -->
        <activity
            android:name=".ui.AssistantSelfTestActivity"
            android:exported="${hermesProofExported}"
            android:label="Asistan Öz-Testi"
            android:noHistory="true"
            android:theme="@style/Theme.HermesMobile" />

        <!-- Tur-24 (JARVIS-2): sürekli sesli sohbet DÖNGÜSÜ kanıtı. Gerçek
             JarvisLoopController + gerçek ticker; çevre sahte (2 tur + kapat
             komutu). Yalnız adb'den explicit açılır. -->
        <activity
            android:name=".ui.JarvisLoopProofActivity"
            android:exported="${hermesProofExported}"
            android:label="Jarvis Döngü Kanıtı"
            android:noHistory="true"
            android:theme="@style/Theme.HermesMobile" />
    </application>
</manifest>
