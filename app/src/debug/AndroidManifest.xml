<?xml version="1.0" encoding="utf-8"?>
<!--
  Yalnız DEBUG build'e merge olur (src/debug source set): mesaj render
  tasarımı için görsel kanıt ekranı. Launcher'da YOK — yalnız adb'den
  explicit component ile açılır. Üretim (release) manifest'ine sızmaz.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".ui.MarkdownRenderDebugActivity"
            android:exported="true"
            android:label="Render Kanıtı"
            android:theme="@style/Theme.HermesMobile" />

        <!-- Tur-6: "tam kontrol" zincirini kurmak için ayar tohumlayıcı.
             Yalnız debug; token dosyadan okunur, komut satırına yazılmaz. -->
        <activity
            android:name=".ui.Tur6SeedActivity"
            android:exported="true"
            android:label="Tur6 Tohum"
            android:noHistory="true"
            android:theme="@style/Theme.HermesMobile" />

        <!-- Tur-11: sesli mesaj öz-testi. Asset'teki kaydı gerçek istemci
             koduyla uca yükler (/transcribe → metin), sentezleyip indirir
             (/synthesize → ogg) ve MediaPlayer ile çalar. Token intent
             extra'sıyla geçirilir; kaynakta/kalıcı depoda durmaz. -->
        <activity
            android:name=".ui.VoiceSelfTestActivity"
            android:exported="true"
            android:label="Sesli Mesaj Öz-Testi"
            android:noHistory="true"
            android:theme="@style/Theme.HermesMobile" />

        <!-- Tur-21: yerel kadın sesi (Piper/sherpa-onnx) + yerel LLM
             sağlık/chat öz-testi. Kanıt WAV'ları shared-depo dışı
             filesDir.parentFile/local-tts-kanit'e yazılır (run-as ile çekilir). -->
        <activity
            android:name=".ui.LocalTtsSelfTestActivity"
            android:exported="true"
            android:label="Yerel Ses Öz-Testi"
            android:noHistory="true"
            android:theme="@style/Theme.HermesMobile" />

        <!-- Tur-13: telefon asistanı öz-testi. Asistan modu kararlarını (saf
             katman) + kayıt durum makinesini + gerçek istemciyle transcribe →
             oto-okuma → sentez → çalma zincirini koşturur. Token intent
             extra'sıyla geçirilir; kaynakta/kalıcı depoda durmaz. -->
        <activity
            android:name=".ui.AssistantSelfTestActivity"
            android:exported="true"
            android:label="Asistan Öz-Testi"
            android:noHistory="true"
            android:theme="@style/Theme.HermesMobile" />
    </application>
</manifest>
